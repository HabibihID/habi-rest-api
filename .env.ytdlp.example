# ============================================
# CONTOH KONFIGURASI YTDLP (copy ke .env)
# ============================================

# --- Proxy untuk yt-dlp (OPSIONAL) ---
# Format: http://username:password@host:port
#   atau: http://host:port  (tanpa auth)
#   atau: socks5://username:password@host:port
#
# Jika dikosongkan, yt-dlp jalan LANGSUNG tanpa proxy (seperti sekarang).
# Proxy HANYA dipakai untuk request yt-dlp ke YouTube,
# TIDAK memengaruhi koneksi WhatsApp/bot.
#
# Contoh residential proxy:
# YTDLP_PROXY=http://user123:pass456@192.168.1.100:8080
#
# Contoh tanpa auth:
# YTDLP_PROXY=http://192.168.1.100:8080
#
# Nonaktifkan (default):
YTDLP_PROXY=

# --- Cookies YouTube (OPSIONAL) ---
# Path ke file cookies format Netscape (dari ekstensi "Get cookies.txt").
# Jika dikosongkan atau file tidak ada, cookies tidak dipakai.
#
# Contoh:
# YTDLP_COOKIES=/home/ubuntu/habi-rest-api/yt-cookies.txt
#
# Nonaktifkan (default):
YTDLP_COOKIES=
